# Supabase project URL and anon (public) key — from Project Settings ->
# API in the Supabase dashboard. The anon key is meant to be public (Row
# Level Security is what actually restricts access); NEXT_PUBLIC_ vars are
# exposed to the browser bundle by design. Used by lib/supabase/client.ts
# and lib/supabase/server.ts. The app itself still builds/runs without
# these set, since nothing calls those clients yet.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key — from the same API settings page. Bypasses
# Row Level Security entirely. Used only by lib/supabase/admin.ts, which
# must never be imported by client components. NEVER prefix this with
# NEXT_PUBLIC_ — doing so would ship it to every browser.
SUPABASE_SERVICE_ROLE_KEY=

# Email of the account that should be granted the admin role once
# authentication exists (Phase 2). Never commit the real address here —
# set it in the actual deployment/local environment only.
ADMIN_EMAIL=

# Groq API key — used as the fallback provider for chat generation (see
# GOOGLE_API_KEY below). Server-only — never prefix with NEXT_PUBLIC_.
GROQ_API_KEY=your_api_key_here

# Gemini API key from Google AI Studio (aistudio.google.com -> Get API
# key) — the primary chat provider, with an automatic fallback to Groq if
# it's absent or fails. Server-only — never prefix with NEXT_PUBLIC_.
# Read explicitly via createGoogle({ apiKey: ... }) in lib/ai/config.ts —
# NOT the same as @ai-sdk/google's own default env var name
# (GOOGLE_GENERATIVE_AI_API_KEY) — don't rename this to that.
GOOGLE_API_KEY=your_api_key_here
